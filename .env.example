# Avalon JWT configuration
# WARNING: Never commit real secrets to version control.
# Copy this file to .env and replace placeholders with real values.

# JWT signing secret — must be 32+ bytes
# Generate with: openssl rand -base64 32
AVALON_JWT_SECRET=CHANGE_ME_32_BYTE

# JWT token lifetime in seconds (default: 7200 = 2 hours)
AVALON_JWT_TTL_SECONDS=7200

# JWT refresh signing secret — must be 32+ bytes (separate from access secret)
# Generate with: openssl rand -base64 32
AVALON_JWT_REFRESH_SECRET=CHANGE_ME_32_BYTE

# Refresh token lifetime in seconds (default: 86400 = 24 hours)
AVALON_JWT_REFRESH_TTL_SECONDS=86400

# T-511 GM/Admin ops channel. Generate a distinct secret; never expose/port-forward port 9215.
# The world listener is fixed to 127.0.0.1 and remains disabled when this is empty.
AVALON_OPS_SECRET=
AVALON_OPS_PORT=9215

# Browser-facing GM panel. Keep the default loopback bind; NEVER port-forward port 8095.
# Generate a second, distinct token with: openssl rand -base64 32
AVALON_ADMIN_TOKEN=
AVALON_ADMIN_BIND=127.0.0.1
AVALON_ADMIN_PORT=8095
